# Token from @BotFather on Telegram (e.g. 123456789:AAExampleTokenValueHere)
TELEGRAM_BOT_TOKEN=

# Set to "http" to run as a remote MCP server (required for Claude.ai / deployment).
# Leave unset or "stdio" to run as a local MCP server for Claude Desktop / Claude Code.
TRANSPORT=http

# Port the HTTP server listens on (most hosting platforms set this automatically)
PORT=3000
